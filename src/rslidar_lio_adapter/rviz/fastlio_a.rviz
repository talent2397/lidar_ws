Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Fixed Frame: odom
      Plane Cell Count: 40
      Cell Size: 1
    - Class: rviz_default_plugins/Path
      Name: Path
      Topic:
        Value: /path
    - Class: rviz_default_plugins/PointCloud2
      Name: CloudRegisteredBase
      Topic:
        Value: /cloud_registered_base
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/PointCloud2
      Name: CloudBody
      Topic:
        Value: /cloud_registered_body
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR2 Points
      Enabled: false
      Topic:
        Value: /rslidar_points_2
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR2 Map
      Enabled: true
      Topic:
        Value: /rslidar_points_2_map
      Style: Points
      Size (Pixels): 2
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 5
  Fixed Frame: odom
  Grid:
    Enabled: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
